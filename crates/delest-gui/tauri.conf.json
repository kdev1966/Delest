{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Delest",
  "identifier": "dev.kdev1966.delest",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Delest",
        "url": "index.html",
        "visible": false,
        "width": 820,
        "height": 494,
        "resizable": false,
        "theme": "Dark",
        "decorations": false,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "barre",
        "title": "Delest",
        "url": "barre.html",
        "width": 156,
        "height": 494,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "theme": "Dark",
        "transparent": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
